<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_employee" model="ir.actions.act_window">
        <field name="res_model">expense.manager.employee</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">expense.manager.employee.tree</field>
        <field name="model">expense.manager.employee</field>
        <field name="arch" type="xml">
            <tree default_order="id desc">
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">expense.manager.employee.tree</field>
        <field name="model">expense.manager.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                        <group>
                            <field name="user_id"/>
                        </group>

                    <notebook>
                        <page name="خرید ها">
                            <field name="expense_ids">
                                <tree>
                                    <field name="line_ids"/>
                                    <field name="date"/>
                                    <field name="total_amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>