<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_expense" model="ir.actions.act_window">
        <field name="name">خرید ها</field>
        <field name="res_model">expense.manager.expense</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_expense_tree" model="ir.ui.view">
            <field name="name">expense.manager.tree</field>
            <field name="model">expense.manager.expense</field>
            <field name="arch" type="xml">
                <tree default_order="id desc">
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="total_amount"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

    <record id="view_expense_form" model="ir.ui.view">
        <field name="name">expense.manager.expense.form</field>
        <field name="model">expense.manager.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="اقلام خرید">
                            <field name="line_ids">
                                <tree>
                                    <field name="type_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="total_amount" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>