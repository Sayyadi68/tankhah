<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_type" model="ir.actions.act_window">
        <field name="name">انواع هزینه</field>
        <field name="res_model">expense.manager.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_type_tree" model="ir.ui.view">
        <field name="name">expense.manager.type.tree</field>
        <field name="model">expense.manager.type</field>
        <field name="arch" type="xml">
            <tree default_order="id desc">
                <field name="name"/>
            </tree>
        </field>
    </record>

     <record id="view_type_form" model="ir.ui.view">
        <field name="name">expense.manager.type.form</field>
        <field name="model">expense.manager.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    <notebook>
                        <page name="اقلام خرید">
                            <field name="line_ids">
                                <tree>
                                    <field name="expense_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="total_amount" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>