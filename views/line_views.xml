<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_line" model="ir.actions.act_window">
        <field name="name">اقلام خرید</field>
        <field name="res_model">expense.manager.line</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_line_tree" model="ir.ui.view">
        <field name="name">expense.manager.line.tree</field>
        <field name="model">expense.manager.line</field>
        <field name="arch" type="xml">
            <tree default_order="id desc">
                <field name="expense_id"/>
                <field name="type_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="total_amount" readonly="1"/>
            </tree>
        </field>
    </record>

</odoo>